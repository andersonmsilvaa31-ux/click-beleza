{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Click Beleza: iniciar servidor local",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}\\consulta_cep.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "env": {
          "CLICK_BELEZA_DATABASE_URL": "postgresql://click_beleza_app@127.0.0.1:5432/click_beleza"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$python",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Click Beleza local:",
          "endsPattern": "Pressione Ctrl\\+C para encerrar\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Click Beleza: testar API",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Click Beleza: criar primeiro administrador",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}\\scripts\\create_admin.py"
      ],
      "options": {
        "env": {
          "CLICK_BELEZA_DATABASE_URL": "postgresql://click_beleza_app@127.0.0.1:5432/click_beleza",
          "CLICK_BELEZA_ADMIN_LOGIN": "admin@clickbeleza.local"
        }
      },
      "problemMatcher": []
    }
  ]
}
