{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Click Beleza: iniciar servidor local",
      "type": "process",
      "command": "python",
      "args": [
        "-u",
        "${workspaceFolder}\\consulta_cep.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": {
        "base": "$python",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Click Beleza local:",
          "endsPattern": "Pressione Ctrl\\+C para encerrar\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Click Beleza: testar API",
      "type": "process",
      "command": "python",
      "args": [
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests",
        "-v"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
